# SUPABASE
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# STRIPE (Public Key - Safe for Frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# API Base URL for Netlify Functions
VITE_API_URL=http://localhost:8888/.netlify/functions

# App Settings
VITE_APP_NAME=VELORIA
VITE_APP_URL=http://localhost:5173

# NOTE: Sensitive keys (STRIPE_SECRET_KEY, RESEND_API_KEY, etc.) 
# should ONLY be in Netlify Environment Variables or netlify.toml
